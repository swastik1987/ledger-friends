# Loaded by Vite only for `vite build --mode capacitor` (the Android build),
# on top of .env. Lovable never reads or regenerates this file.
#
# Google OAuth **Web application** client ID used for native Google sign-in
# (src/lib/nativeGoogleAuth.ts). Client IDs are public identifiers, not
# secrets — never put the client *secret* here. Setup: docs/android-google-signin.md
VITE_GOOGLE_WEB_CLIENT_ID=748849808422-b8cmjp4h89difrh6hijd895lqqlh6tpb.apps.googleusercontent.com
